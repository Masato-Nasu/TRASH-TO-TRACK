<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRASH TO TRACK"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DELETE DATA / REFINE MUSIC"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/apiButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/line"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="SETTINGS"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The app's core: deleted bytes become TRACK credit. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/panel"
        android:orientation="vertical"
        android:padding="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRASH BANK"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bankBytesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 B"
                    android:textColor="@color/white"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/bankTracksText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 TRACKS READY"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/bankProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bank" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DELETE 25 MB  →  1 TRACK"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/makeTracksButton"
                android:layout_width="152dp"
                android:layout_height="42dp"
                android:backgroundTint="@color/accent"
                android:enabled="false"
                android:minWidth="0dp"
                android:text="MAKE TRACKS"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/fileAccessButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="@color/accent"
        android:text="ALLOW FILE ACCESS"
        android:textColor="@color/black"
        android:textSize="10sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <Button android:id="@+id/tabAll" android:layout_width="68dp" android:layout_height="34dp" android:background="@drawable/tab_selected" android:minWidth="0dp" android:text="ALL" android:textColor="@color/black" android:textSize="10sp" android:textStyle="bold" />
            <Button android:id="@+id/tabPhoto" android:layout_width="78dp" android:layout_height="34dp" android:layout_marginStart="5dp" android:background="@drawable/tab_normal" android:minWidth="0dp" android:text="PHOTO" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
            <Button android:id="@+id/tabVideo" android:layout_width="78dp" android:layout_height="34dp" android:layout_marginStart="5dp" android:background="@drawable/tab_normal" android:minWidth="0dp" android:text="VIDEO" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
            <Button android:id="@+id/tabDoc" android:layout_width="68dp" android:layout_height="34dp" android:layout_marginStart="5dp" android:background="@drawable/tab_normal" android:minWidth="0dp" android:text="DOC" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
            <Button android:id="@+id/tabAudio" android:layout_width="78dp" android:layout_height="34dp" android:layout_marginStart="5dp" android:background="@drawable/tab_normal" android:minWidth="0dp" android:text="AUDIO" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/folderUpButton"
            android:layout_width="48dp"
            android:layout_height="34dp"
            android:backgroundTint="@color/line"
            android:enabled="false"
            android:minWidth="0dp"
            android:text="UP"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/folderPathText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="STORAGE"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/newFolderButton"
            android:layout_width="76dp"
            android:layout_height="34dp"
            android:backgroundTint="@color/line"
            android:minWidth="0dp"
            android:text="+ FOLDER"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clearSelectionButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:backgroundTint="@color/line"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="CLEAR"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ListView
        android:id="@+id/fileListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:paddingBottom="4dp" />

    <!-- Bottom area changes only when selection/move/generation needs attention. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/selectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="TAP: OPEN  ·  HOLD: SELECT"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ProgressBar android:id="@+id/busyProgress" android:layout_width="18dp" android:layout_height="18dp" android:indeterminateTint="@color/accent" android:visibility="gone" />
            <TextView android:id="@+id/statusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:text="READY" android:textColor="@color/white" android:textSize="10sp" android:textStyle="bold" />
            <Button android:id="@+id/stopGenerationButton" android:layout_width="wrap_content" android:layout_height="30dp" android:backgroundTint="@color/danger" android:minWidth="0dp" android:paddingHorizontal="10dp" android:text="STOP" android:textColor="@color/black" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
            <Button android:id="@+id/openFolderButton" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="5dp" android:backgroundTint="@color/line" android:minWidth="0dp" android:paddingHorizontal="9dp" android:text="OPEN" android:textColor="@color/white" android:textSize="9sp" android:visibility="gone" />
            <Button android:id="@+id/playButton" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="5dp" android:backgroundTint="@color/line" android:minWidth="0dp" android:paddingHorizontal="9dp" android:text="PLAY" android:textColor="@color/white" android:textSize="9sp" android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/deleteEmptyFolderButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/danger"
            android:enabled="false"
            android:text="DELETE EMPTY FOLDER"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/moveButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="@color/line"
                android:enabled="false"
                android:text="MOVE"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/bankButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1.35"
                android:backgroundTint="@color/danger"
                android:enabled="false"
                android:text="DELETE → TRACK CREDIT"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/pasteButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent"
                android:enabled="false"
                android:text="MOVE HERE"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/cancelMoveButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="7dp"
                android:backgroundTint="@color/line"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="CANCEL"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
